# ==================== Core ====================
NODE_ENV=development
PORT=50001
DISABLE_SWAGGER=false

# ==================== MongoDB ====================
DB_URI=mongodb://localhost:27017

# ==================== Auth (JWT) ====================
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# ==================== S3 / attachments ====================
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_NAME=
DEPLOYED_ENVIRONMENT=development

# ==================== Web push notifications ====================
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# ==================== RabbitMQ (delayed notifications) ====================
# Optional: leave RMQ_URI empty to skip loading the queue module.
RMQ_URI=amqp://app:app123@localhost:5673/
RMQ_QUEUE_NAME=notifications

# ==================== SMS (Unifonic) ====================
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
# UNIFONIC_API_URL=https://el.cloud.unifonic.com/rest/SMS/messages

# ==================== Mail (SMTP) ====================
# Leave SMTP_HOST empty to skip sending; in development the email is logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender address. Defaults to SMTP_USER — set it when SMTP_USER isn't an email (SES, SendGrid, ...).
MAIL_FROM=
MAIL_BRAND_NAME=App
MAIL_COMPANY_NAME=Your Company
MAIL_SUPPORT_EMAIL=support@example.com
