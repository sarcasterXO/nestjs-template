FROM rabbitmq:4.2.7-management-alpine

# Install curl for downloading the plugin
RUN apk add --no-cache curl

# Download and install the delayed message exchange plugin.
# Plugin v4.2.0 is built against RabbitMQ server 4.2.x (matches the base image line).
RUN curl -L https://github.com/rabbitmq/rabbitmq-delayed-message-exchange/releases/download/v4.2.0/rabbitmq_delayed_message_exchange-4.2.0.ez \
    -o $RABBITMQ_HOME/plugins/rabbitmq_delayed_message_exchange-4.2.0.ez

# Enable the plugin
RUN rabbitmq-plugins enable rabbitmq_delayed_message_exchange

